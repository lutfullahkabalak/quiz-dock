{
  "realm": "quiz-dock",
  "enabled": true,
  "displayName": "QuizDock",
  "roles": {
    "realm": [
      { "name": "host", "description": "Animateur / créateur de quiz" },
      { "name": "player", "description": "Participant connecté" },
      { "name": "admin", "description": "Administrateur (réservé v1.1)" }
    ]
  },
  "clients": [
    {
      "clientId": "quiz-dock-frontend",
      "name": "QuizDock Frontend (SPA)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["${KEYCLOAK_APP_URL}/*"],
      "webOrigins": ["${KEYCLOAK_APP_URL}"]
    }
  ],
  "users": [
    {
      "id": "2bca0877-373c-460c-a37d-6520be91d3b4",
      "username": "host",
      "enabled": true,
      "email": "host@quiz-dock.test",
      "emailVerified": true,
      "firstName": "Alex",
      "lastName": "Host",
      "credentials": [
        { "type": "password", "value": "${KEYCLOAK_HOST_PASSWORD}", "temporary": true }
      ],
      "requiredActions": ["UPDATE_PASSWORD"],
      "realmRoles": ["host", "admin"]
    },
    {
      "id": "39b95ebf-1a3f-4b7f-a53e-105e57137962",
      "username": "player",
      "enabled": true,
      "email": "player@quiz-dock.test",
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Player",
      "credentials": [
        { "type": "password", "value": "${KEYCLOAK_PLAYER_PASSWORD}", "temporary": true }
      ],
      "requiredActions": ["UPDATE_PASSWORD"],
      "realmRoles": ["player"]
    }
  ]
}
